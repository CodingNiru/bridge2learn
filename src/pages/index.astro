---
import SiteLayout from '../layouts/SiteLayout.astro';

const infrastructure = [
  {
    title: 'A place to learn',
    detail:
      'A secure, accessible location for students and the surrounding community — for example, a school, library or community center.',
  },
  {
    title: 'A reliable connection',
    detail:
      'A dependable internet connection, with options suited to local coverage and conditions.',
  },
  {
    title: 'Shared devices',
    detail: 'A Wi-Fi router and Chromebooks or other low-cost laptops.',
  },
  {
    title: 'Learning tools',
    detail:
      'Useful online learning resources, with AI tools selected to support the curriculum and the needs of students.',
  },
  {
    title: 'Safer access',
    detail:
      'Thoughtful device and network settings help keep learning focused and access safer.',
  },
  {
    title: 'A confident start',
    detail:
      'A welcoming introduction to the devices and learning tools, backed by people who can help.',
  },
];

const roadmap = [
  {
    title: 'Listen and scope locally',
    detail:
      'Work with learners, educators, caregivers and community organizations to understand needs, languages, access and learning goals.',
  },
  {
    title: 'Build a realistic budget',
    detail:
      'Confirm connectivity, devices, training, safety and other local costs before setting a funding target.',
  },
  {
    title: 'Test the setup',
    detail:
      'Try the learning tools and equipment before rollout, then resolve practical issues with access and support.',
  },
  {
    title: 'Prepare people and place',
    detail:
      'Set up the learning space, agree on adult guidance and privacy practices, and introduce students to the tools.',
  },
  {
    title: 'Review and improve',
    detail:
      'Gather feedback from learners and local partners to understand what is useful and what needs to change.',
  },
];
---

<SiteLayout
  title="Bridge2Learn — A bridge to self-learning"
  description="More room to ask questions, build confidence, and learn—wherever a student lives. Discover Bridge2Learn's vision for accessible, AI-assisted learning in Sri Lanka."
>
  <header class="site-header">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <a class="wordmark" href="#top" aria-label="Bridge2Learn home">Bridge<span>2</span>Learn</a>
    <nav aria-label="Main navigation">
      <a href="#why">Why it matters</a>
      <a href="#approach">Approach</a>
      <a href="#pilot">Pilot plan</a>
      <a class="nav-cta" href="#roadmap">Pilot planning <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero page-grid" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">A bridge to<br />learning.</h1>
        <p class="hero-intro">
          A vision for accessible, AI-assisted learning in Sri Lanka—making room to ask questions,
          build confidence and learn, wherever students live.
        </p>
        <a class="action-link" href="#pilot">
          Explore the journey <span aria-hidden="true">↓</span>
        </a>
        <p class="hero-context">Curiosity has no postcode.</p>
      </div>
      <figure class="hero-image">
        <img
          src="/images/learning-landscape.svg"
          alt="A learner follows a path between a village classroom and digital learning tools."
          fetchpriority="high"
          width="1200"
          height="960"
          decoding="async"
        />
        <figcaption>Every question can open a new path.</figcaption>
      </figure>
    </section>

    <section class="why section-pad" id="why" aria-labelledby="why-title">
      <div class="why-heading">
        <h2 id="why-title">Let learning travel.</h2>
      </div>
      <div class="why-body">
        <p class="lead">
          Every learner deserves the chance to explore, ask questions, and get support. Bridge2Learn
          focuses on making useful learning resources easier to reach, including in rural communities.
        </p>
        <div class="challenge-list">
          <article>
            <h3>Fewer ways to get help</h3>
            <p>Teacher shortages and limited access to extra support can make learning harder to sustain.</p>
          </article>
          <article>
            <h3>Digital tools are not within reach</h3>
            <p>Basic computers and internet access are not always available or connected to learning.</p>
          </article>
          <article>
            <h3>AI should widen opportunity</h3>
            <p>
              With thoughtful guidance, AI can help students explore ideas and develop their talents.
            </p>
          </article>
          <article>
            <h3>Build for lasting support</h3>
            <p>
              Learning support should be useful over time. Accessible self-learning can complement
              the people and resources already supporting students.
            </p>
          </article>
        </div>
      </div>
      <figure class="why-image">
        <img
          src="/images/learning-together.svg"
          alt="Two learners share ideas over an open book."
          loading="lazy"
          width="1000"
          height="720"
          decoding="async"
        />
        <figcaption>Learning grows when ideas are shared.</figcaption>
      </figure>
    </section>

    <section class="approach section-pad" id="approach" aria-labelledby="approach-title">
      <div class="approach-intro">
        <h2 id="approach-title">Start with self-learning.</h2>
        <p>
          Bring accessible digital resources together with practical guidance, then grow toward
          learning support that responds to each student's questions.
        </p>
      </div>
      <div class="approach-image">
        <img
          src="/images/learning-tools.svg"
          alt="A tablet displays a learning prompt beside study notes and a plant."
          loading="lazy"
          width="900"
          height="620"
          decoding="async"
        />
        <p class="image-note">Digital tools, made more human.</p>
      </div>
      <div class="approach-details">
        <h3>Start with tools students can reach.</h3>
        <p>
          Start with accessible online resources, strengthen digital confidence, and work alongside
          local communities to extend learning support.
        </p>
        <h3>Let questions lead the way.</h3>
        <p>
          Begin with a familiar chat-based experience where students can ask subject questions and
          practise for exams, with clear guidance for using AI.
        </p>
        <p class="approach-note">
          Learning can connect to class notes, videos, and the curriculum students already know.
          Support should feel relevant, understandable, and easy to explore.
        </p>
      </div>
    </section>

    <section class="phases section-pad" id="pilot" aria-labelledby="phases-title">
      <div class="phases-heading">
        <h2 id="phases-title">Start with Phase 1.</h2>
        <p>
          Build thoughtfully, one step at a time—from useful chat support to more personal learning
          experiences.
        </p>
      </div>
      <div class="phase-list">
        <details class="phase" open>
          <summary>
            <span>Phase 1</span>
            <span class="phase-title">Interactive chat-based learning</span>
            <span class="phase-toggle" aria-hidden="true">+</span>
          </summary>
          <div class="phase-content">
            <p>
              Explore a simple chat-based learning service that helps students ask questions, get
              subject support, and prepare for exams.
            </p>
            <p>
              A useful learning habit: ask a question, request the steps, then check the explanation
              against class material.
            </p>
          </div>
        </details>
        <details class="phase">
          <summary>
            <span>Phase 2</span>
            <span class="phase-title">An AI-assisted audio-visual teacher</span>
            <span class="phase-toggle" aria-hidden="true">+</span>
          </summary>
          <div class="phase-content">
            <p>
              Develop an AI-assisted audio-visual learning companion for guided, virtual classroom
              sessions.
            </p>
          </div>
        </details>
        <details class="phase">
          <summary>
            <span>Phase 3</span>
            <span class="phase-title">Personalized one-to-one tutoring</span>
            <span class="phase-toggle" aria-hidden="true">+</span>
          </summary>
          <div class="phase-content">
            <p>
              Explore personalized one-to-one tutoring that can explain concepts step by step and
              adapt to each learner's needs.
            </p>
          </div>
        </details>
      </div>
    </section>

    <section class="care section-pad" id="responsible-ai" aria-labelledby="care-title">
      <div class="care-heading">
        <p class="eyebrow">Learning with care</p>
        <h2 id="care-title">AI can help. People stay at the center.</h2>
        <p>
          These are planning principles for a child-centered learning experience—not claims about a
          service already in operation.
        </p>
      </div>
      <div class="care-list">
        <article class="care-item">
          <h3>Keep personal details private</h3>
          <p>
            Avoid sharing a learner's identifying or sensitive information with an AI tool unless
            its privacy practices have been checked by a trusted adult.
          </p>
        </article>
        <article class="care-item">
          <h3>Check important answers</h3>
          <p>
            AI can be inaccurate. Compare useful answers with class notes, textbooks or a teacher.
          </p>
        </article>
        <article class="care-item">
          <h3>Keep people involved</h3>
          <p>
            Use AI to support learning alongside teachers, caregivers and other trusted adults—not
            as a replacement for them.
          </p>
        </article>
        <article class="care-item">
          <h3>Design for every learner</h3>
          <p>
            Choose tools and learning materials with students' languages, abilities, curriculum and
            access needs in mind.
          </p>
        </article>
      </div>
      <p class="care-reference">
        These principles draw on UNICEF's
        <a
          href="https://www.unicef.org/innocenti/reports/policy-guidance-ai-children"
          target="_blank"
          rel="noopener noreferrer"
        >Guidance on AI and children (version 3.0, 2025)</a>, which highlights safety, privacy,
        fairness, transparency, well-being and inclusion.
      </p>
    </section>

    <section class="hub section-pad" aria-labelledby="hub-title">
      <div class="hub-heading">
        <h2 id="hub-title">Build a learning hub.</h2>
        <p>
          A welcoming place, dependable connectivity, shared devices, useful tools, safer access,
          and helpful guidance make a strong foundation.
        </p>
      </div>
      <div class="hub-list">
        {infrastructure.map((item) => (
          <article class="hub-item">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
      <figure class="hub-image">
        <img
          src="/images/learning-hub.svg"
          alt="A shared learning space with books, computers and places to study."
          loading="lazy"
          width="1200"
          height="700"
          decoding="async"
        />
        <figcaption>A shared space for questions, discovery, and growth.</figcaption>
      </figure>
    </section>

    <section class="roadmap section-pad" id="roadmap" aria-labelledby="roadmap-title">
      <div class="roadmap-heading">
        <h2 id="roadmap-title">Plan the first pilot.</h2>
        <p>
          A thoughtful rollout starts with listening, preparing carefully, and learning from each
          step. Timing will depend on local needs and partnerships.
        </p>
      </div>
      <ol class="roadmap-list">
        {roadmap.map((step, index) => (
          <li>
            <span class="roadmap-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="budget section-pad" aria-labelledby="budget-title">
      <div class="budget-intro">
        <h2 id="budget-title">Early cost estimates.</h2>
        <p>
          Early planning figures are estimates, not quotes or a complete budget. Actual costs depend
          on local needs, availability and the final setup.
        </p>
        <p class="budget-total">
          The listed items add up to about <strong>US$1,900 for the first year</strong>, excluding
          costs marked “Not priced.”
        </p>
        <a href="#roadmap" class="text-link">See how the pilot takes shape <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="budget-list">
        <div>
          <dt>Internet setup</dt>
          <dd>About US$500</dd>
          <dd class="budget-note">Initial setup estimate</dd>
        </div>
        <div>
          <dt>Internet service</dt>
          <dd>About US$600 / year</dd>
          <dd class="budget-note">One year of service estimate</dd>
        </div>
        <div>
          <dt>Wi-Fi router</dt>
          <dd>US$100</dd>
          <dd class="budget-note">Hardware estimate</dd>
        </div>
        <div>
          <dt>Chromebooks</dt>
          <dd>5 × US$100 · about US$500</dd>
          <dd class="budget-note">Estimate for five devices</dd>
        </div>
        <div>
          <dt>Selected AI subscriptions</dt>
          <dd>About US$200 / year</dd>
          <dd class="budget-note">Some learning tools may be available at no cost</dd>
        </div>
        <div>
          <dt>Location, safety setup and training</dt>
          <dd>Not priced</dd>
          <dd class="budget-note">Local arrangements and costs still need to be established</dd>
        </div>
      </dl>
    </section>

    <section class="get-involved section-pad" id="get-involved" aria-labelledby="get-involved-title">
      <div class="get-involved-copy">
        <h2 id="get-involved-title">Learning, built with local voices.</h2>
        <p>
          A local pilot would need to be shaped with the learners, educators, caregivers and
          community organizations it is meant to serve. The steps on this page are a starting point
          for that conversation—not a confirmed rollout.
        </p>
      </div>
      <div class="get-involved-action">
        <a class="action-link action-link-light" href="#roadmap">
          Review the pilot steps <span aria-hidden="true">↓</span>
        </a>
        <p>Start with local needs, a practical setup and a way to learn what works.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <a class="wordmark wordmark-footer" href="#top">Bridge<span>2</span>Learn</a>
      <p>Self-learning in Sri Lanka</p>
      <a href="#top" class="back-to-top">Back to top ↑</a>
    </div>
    <p class="footer-note">
      Bridge2Learn is being shaped around the needs of learners and local communities. Pilot details
      and total costs depend on planning, partnerships, and the needs of each location.
    </p>
  </footer>

</SiteLayout>
